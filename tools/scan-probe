#!/bin/sh
# Read-only recon of RICOH SP 202SN scanner surface. Usage: tools/scan-probe [ip]
IP=${1:-192.168.1.60}
echo "== TCP ports"
{ seq 1 1024; echo 1865; echo 2000; echo 5000; seq 8000 8100; seq 9000 9500; seq 49152 49200; seq 54921 54925; echo 60000; } | \
  xargs -P 64 -I{} sh -c "nc -z -G 1 $IP {} 2>/dev/null && echo open {}" | sort -k2 -n
echo "== HTTP"
for p in / /eSCL/ScannerCapabilities /eSCL/ScannerStatus /WSD /StableWSDiscoveryEndpoint/schemas-xmlsoap-org_ws_2005_04_discovery; do
  printf '%s -> ' "$p"; curl -s -m 5 -o /dev/null -w '%{http_code} %{size_download}\n' "http://$IP$p"
done
echo "== SNMP ricoh enterprise"
snmpwalk -v1 -c public -t 2 -r 1 $IP 1.3.6.1.4.1.367 2>&1 | head -200
echo "== hrDeviceTable"
snmpwalk -v1 -c public -t 2 -r 1 $IP 1.3.6.1.2.1.25.3.2 2>&1 | head -50
echo "== WS-Discovery"
python3 - "$IP" <<'PY'
import socket,sys,uuid
ip=sys.argv[1]
m=f'<?xml version="1.0"?><e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope" xmlns:w="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery"><e:Header><w:MessageID>uuid:{uuid.uuid4()}</w:MessageID><w:To>urn:schemas-xmlsoap-org:ws:2005:04:discovery</w:To><w:Action>http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</w:Action></e:Header><e:Body><d:Probe/></e:Body></e:Envelope>'
s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);s.settimeout(3)
s.sendto(m.encode(),("239.255.255.250",3702))
try:
  while True:
    d,a=s.recvfrom(65535)
    if a[0]==ip: print(a,d.decode(errors='replace'))
    else: print("other",a[0])
except Exception as e: print("end:",e)
s.sendto(m.encode(),(ip,3702))
s.settimeout(3)
try:
  d,a=s.recvfrom(65535);print("unicast",a,d.decode(errors='replace'))
except Exception as e: print("unicast end:",e)
PY
